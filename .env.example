# App
APP_ENV=development
APP_SECRET_KEY=change-me-with-at-least-32-characters
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://lumina:lumina@postgres:5432/lumina
POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina

# LLM (Groq Free Plan is the default; leave its key empty for local fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TEMPERATURE=0.2

# RAG and security
RAG_VECTOR_CANDIDATES=24
RAG_LEXICAL_CANDIDATES=24
RAG_RERANK_TOP_K=6
RAG_MIN_RELEVANCE=0.18
MAX_USER_MESSAGE_CHARS=4000
ENABLE_RAGAS=false
